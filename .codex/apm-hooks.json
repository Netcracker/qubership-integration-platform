{
  "Stop": [
    {
      "hooks": [
        {
          "type": "command",
          "statusMessage": "Recording agent telemetry",
          "command": "ai-agent-telemetry ingest --agent=codex",
          "timeout": 30
        }
      ],
      "_apm_source": "netcracker/qubership-ai-agent-telemetry/agent-packages/ai-agent-telemetry"
    }
  ],
  "PostToolUse": [
    {
      "matcher": "mcp__.*",
      "hooks": [
        {
          "type": "command",
          "statusMessage": "Recording agent telemetry",
          "command": "ai-agent-telemetry ingest --agent=codex",
          "timeout": 30
        }
      ],
      "_apm_source": "netcracker/qubership-ai-agent-telemetry/agent-packages/ai-agent-telemetry"
    }
  ]
}

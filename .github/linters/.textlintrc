{
    "rules": {
        "terminology": {
            "//": "Entries are the dictionary's own patterns, matched verbatim; see terms.jsonc in textlint-rule-terminology. The last three are terms whose replacement fights how this repository writes: AGENTS.md is generated by the APM CLI and cannot be hand-edited, and a hyphenated compound modifier such as code-review replies is correct English.",
            "exclude": [
                "V[ -]?S[ -]?Code",
                "file[- ]name(s)?",
                "ID",
                "JSON",
                "readme(s)?",
                "repo\\b",
                "code-?review(s)?"
            ]
        }
    }
}

<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>org.qubership.integration.platform</groupId>
    <artifactId>qip-ai-service</artifactId>
    <version>0.5.0-SNAPSHOT</version>
    <packaging>quarkus</packaging>
    <name>QIP AI Service</name>
    <description>Quarkus AI service for QIP chain design, planning, and catalog implementation</description>
    <url>https://github.com/Netcracker/qubership-integration-platform</url>

    <licenses>
        <license>
            <name>Apache-2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <scm>
        <connection>scm:git:https://github.com/Netcracker/qubership-integration-platform.git</connection>
        <developerConnection>scm:git:https://github.com/Netcracker/qubership-integration-platform.git</developerConnection>
        <url>https://github.com/Netcracker/qubership-integration-platform</url>
        <tag>HEAD</tag>
    </scm>

    <properties>
        <compiler-plugin.version>3.15.0</compiler-plugin.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <quarkus.platform.artifact-id>quarkus-bom</quarkus.platform.artifact-id>
        <quarkus.platform.group-id>io.quarkus.platform</quarkus.platform.group-id>
        <quarkus.platform.version>3.33.3</quarkus.platform.version>
        <a2a.version>1.1.0.Final</a2a.version>
        <!-- Flow 0.14.0 and Quarkus LangChain4j 1.12.2 target the Quarkus 3.33 LTS line. -->
        <quarkus-flow.version>0.14.0</quarkus-flow.version>
        <quarkus-langchain4j.version>1.12.2</quarkus-langchain4j.version>
        <skipITs>true</skipITs>
        <surefire-plugin.version>3.5.4</surefire-plugin.version>
        <wiremock.version>3.10.0</wiremock.version>
        <qip-checkstyle-revision>0.0.3</qip-checkstyle-revision>
        <flatten-maven-plugin.version>1.5.0</flatten-maven-plugin.version>
        <jacoco.plugin.version>0.8.14</jacoco.plugin.version>
        <sonar.coverage.jacoco.xmlReportPaths>${project.basedir}/target/site/jacoco/jacoco.xml</sonar.coverage.jacoco.xmlReportPaths>
        <qip.schemas.sync.skip>false</qip.schemas.sync.skip>
        <qip.schemas.local.dir>${project.basedir}/../schemas/src/main/resources/qip-model</qip.schemas.local.dir>
        <qip.schemas.download.url>
            https://github.com/Netcracker/qubership-integration-schemas/archive/refs/heads/main.tar.gz
        </qip.schemas.download.url>
        <qip.ai.qipknowledge.build.skip>true</qip.ai.qipknowledge.build.skip>
        <qip.ai.qipknowledge.pack-root></qip.ai.qipknowledge.pack-root>
        <qip.ai.qipknowledge.addon-pack-root></qip.ai.qipknowledge.addon-pack-root>
        <qip.ai.qipknowledge.knowledge-overlay></qip.ai.qipknowledge.knowledge-overlay>
        <qip.ai.qipknowledge.output-root>${project.build.outputDirectory}/qipknowledge</qip.ai.qipknowledge.output-root>
    </properties>

    <repositories>
        <repository>
            <id>oss.sonatype.org</id>
            <url>https://central.sonatype.com</url>
            <releases><enabled>true</enabled></releases>
            <snapshots><enabled>false</enabled></snapshots>
        </repository>
        <repository>
            <id>github</id>
            <url>https://maven.pkg.github.com/Netcracker/*</url>
            <releases><enabled>true</enabled></releases>
            <snapshots><enabled>true</enabled></snapshots>
        </repository>
    </repositories>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>${quarkus.platform.group-id}</groupId>
                <artifactId>${quarkus.platform.artifact-id}</artifactId>
                <version>${quarkus.platform.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>io.quarkiverse.langchain4j</groupId>
                <artifactId>quarkus-langchain4j-bom</artifactId>
                <version>${quarkus-langchain4j.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>${quarkus.platform.group-id}</groupId>
                <artifactId>quarkus-amazon-services-bom</artifactId>
                <version>${quarkus.platform.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.a2aproject.sdk</groupId>
                <artifactId>a2a-java-sdk-bom</artifactId>
                <version>${a2a.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Quarkus core -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-arc</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-rest</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-rest-jackson</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.dataformat</groupId>
            <artifactId>jackson-dataformat-yaml</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-smallrye-context-propagation</artifactId>
        </dependency>

        <!-- Workflow orchestration; product-pipeline execution remains on the legacy runtime. -->
        <dependency>
            <groupId>io.quarkiverse.flow</groupId>
            <artifactId>quarkus-flow</artifactId>
            <version>${quarkus-flow.version}</version>
        </dependency>

        <!-- LangChain4j / Quarkus LangChain4j -->
        <dependency>
            <groupId>io.quarkiverse.langchain4j</groupId>
            <artifactId>quarkus-langchain4j-openai</artifactId>
        </dependency>
        <dependency>
            <groupId>com.knuddels</groupId>
            <artifactId>jtokkit</artifactId>
            <version>1.1.0</version>
        </dependency>

        <!-- REST Client for MCP tools -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-rest-client-jackson</artifactId>
        </dependency>

        <!-- Validation -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-hibernate-validator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-cache</artifactId>
        </dependency>
        <dependency>
            <groupId>org.commonmark</groupId>
            <artifactId>commonmark</artifactId>
            <version>0.24.0</version>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>1.18.38</version>
            <scope>provided</scope>
        </dependency>

        <!-- Health check -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-smallrye-health</artifactId>
        </dependency>

        <!-- Micrometer metrics (ADR 0003 P5 capture failure counters) -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-micrometer-registry-prometheus</artifactId>
        </dependency>

        <!-- S3-compatible object storage (MinIO) -->
        <dependency>
            <groupId>io.quarkiverse.amazonservices</groupId>
            <artifactId>quarkus-amazon-s3</artifactId>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>url-connection-client</artifactId>
        </dependency>

        <!-- A2A SDK compatibility probe (prompt 01) -->
        <dependency>
            <groupId>org.a2aproject.sdk</groupId>
            <artifactId>a2a-java-sdk-reference-rest</artifactId>
            <version>${a2a.version}</version>
        </dependency>
        <!--
            JSON-RPC for peers whose client is JSON-RPC only (DCA, Netcracker). The multiversion
            module dispatches POST / on the A2A-Version header: "1.0" speaks SendMessage, "0.3"
            speaks message/send, and a request without the header defaults to 0.3. Python
            a2a-sdk sends message/send and no header, so it lands on the 0.3 handler.
        -->
        <dependency>
            <groupId>org.a2aproject.sdk</groupId>
            <artifactId>a2a-java-sdk-reference-multiversion-jsonrpc</artifactId>
            <version>${a2a.version}</version>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-security</artifactId>
        </dependency>

        <!-- A2A Task persistence (prompt 02): application-owned JDBC + Flyway -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-jdbc-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-agroal</artifactId>
        </dependency>

        <!-- Testing -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit-mockito</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.wiremock</groupId>
            <artifactId>wiremock</artifactId>
            <version>${wiremock.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>5.17.0</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <version>${flatten-maven-plugin.version}</version>
                <configuration>
                    <updatePomFile>true</updatePomFile>
                    <flattenMode>resolveCiFriendliesOnly</flattenMode>
                </configuration>
                <executions>
                    <execution>
                        <id>flatten</id>
                        <phase>process-resources</phase>
                        <goals><goal>flatten</goal></goals>
                    </execution>
                    <execution>
                        <id>flatten.clean</id>
                        <phase>clean</phase>
                        <goals><goal>clean</goal></goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>${quarkus.platform.group-id}</groupId>
                <artifactId>quarkus-maven-plugin</artifactId>
                <version>${quarkus.platform.version}</version>
                <extensions>true</extensions>
            </plugin>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${compiler-plugin.version}</version>
                <configuration>
                    <parameters>true</parameters>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>1.18.38</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>fetch-qip-schemas</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <skip>${qip.schemas.sync.skip}</skip>
                            <executable>${project.basedir}/scripts/fetch-qip-schemas.sh</executable>
                            <environmentVariables>
                                <QIP_SCHEMAS_STAGING_DIR>${project.build.directory}/qip-schemas-staging/qip-schemas</QIP_SCHEMAS_STAGING_DIR>
                                <QIP_SCHEMAS_DOWNLOAD_URL>${qip.schemas.download.url}</QIP_SCHEMAS_DOWNLOAD_URL>
                                <QIP_SCHEMAS_LOCAL_DIR>${qip.schemas.local.dir}</QIP_SCHEMAS_LOCAL_DIR>
                            </environmentVariables>
                        </configuration>
                    </execution>
                    <execution>
                        <id>generate-qip-knowledge-indexes</id>
                        <phase>process-classes</phase>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <skip>${qip.ai.qipknowledge.build.skip}</skip>
                            <mainClass>org.qubership.integration.platform.ai.qipknowledge.pack.QipKnowledgePackBuildGenerator</mainClass>
                            <classpathScope>compile</classpathScope>
                            <arguments>
                                <argument>${qip.ai.qipknowledge.pack-root}</argument>
                                <argument>${qip.ai.qipknowledge.output-root}</argument>
                            </arguments>
                            <systemProperties>
                                <systemProperty>
                                    <key>qip.ai.qipknowledge.addon-pack-root</key>
                                    <value>${qip.ai.qipknowledge.addon-pack-root}</value>
                                </systemProperty>
                                <systemProperty>
                                    <key>qip.ai.qipknowledge.knowledge-overlay</key>
                                    <value>${qip.ai.qipknowledge.knowledge-overlay}</value>
                                </systemProperty>
                            </systemProperties>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <!--
                        The public template keeps Quarkus build-time annotation processing working
                        without private assets. A full build replaces it with the template from the
                        cip-design-generator skill.
                    -->
                    <execution>
                        <id>copy-ids-template-from-skill</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <skip>${qip.ai.qipknowledge.build.skip}</skip>
                            <outputDirectory>${project.build.outputDirectory}/product-pipelines/templates</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.basedir}/../integration-platform-skills/.apm/skills/cip-design-generator/templates</directory>
                                    <includes>
                                        <include>ids_template.md</include>
                                    </includes>
                                </resource>
                            </resources>
                            <overwrite>true</overwrite>
                        </configuration>
                    </execution>
                    <execution>
                        <id>stage-certified-knowledge-export</id>
                        <phase>process-classes</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <skip>${qip.ai.qipknowledge.build.skip}</skip>
                            <outputDirectory>${project.build.directory}/knowledge-runtime</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.basedir}/../integration-platform-skills/.apm/skills/cip-runtime-context-loader/assets/knowledge-export</directory>
                                </resource>
                            </resources>
                            <overwrite>true</overwrite>
                        </configuration>
                    </execution>
                    <execution>
                        <id>overlay-qip-schemas-into-classes</id>
                        <phase>process-classes</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <skip>${qip.schemas.sync.skip}</skip>
                            <outputDirectory>${project.build.outputDirectory}/qip-schemas</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.build.directory}/qip-schemas-staging/qip-schemas</directory>
                                </resource>
                            </resources>
                            <overwrite>true</overwrite>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.gmaven</groupId>
                <artifactId>groovy-maven-plugin</artifactId>
                <version>2.1.1</version>
                <executions>
                    <execution>
                        <id>merge-system-prompts</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>execute</goal>
                        </goals>
                        <configuration>
                            <source>${project.basedir}/scripts/merge-system-prompts.groovy</source>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>properties</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${surefire-plugin.version}</version>
                <configuration>
                    <!-- Attach Mockito as a Java agent so the inline mock maker works on Java 21
                         without local -Dnet.bytebuddy.experimental / self-attach workarounds. -->
                    <argLine>@{argLine} -javaagent:${org.mockito:mockito-core:jar}</argLine>
                    <includes>
                        <include>**/*Test.java</include>
                        <include>**/*IT.java</include>
                    </includes>
                    <systemPropertyVariables>
                        <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
                        <maven.home>${maven.home}</maven.home>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.plugin.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>prepare-agent</goal>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>schemas-from-download</id>
            <properties>
                <qip.schemas.local.dir></qip.schemas.local.dir>
            </properties>
        </profile>
        <profile>
            <id>with-knowledge</id>
            <activation>
                <file>
                    <exists>../integration-platform-skills/.apm/skills/cip-runtime-context-loader/assets/knowledge-export/manifest.yaml</exists>
                </file>
            </activation>
            <properties>
                <qip.ai.qipknowledge.build.skip>false</qip.ai.qipknowledge.build.skip>
                <qip.ai.qipknowledge.pack-root>${project.basedir}/../integration-platform-skills</qip.ai.qipknowledge.pack-root>
                <qip.ai.qipknowledge.addon-pack-root>${project.basedir}/../integration-platform-skills/addons</qip.ai.qipknowledge.addon-pack-root>
            </properties>
        </profile>
        <profile>
            <id>native</id>
            <activation>
                <property>
                    <name>native</name>
                </property>
            </activation>
            <properties>
                <quarkus.package.jar.enabled>false</quarkus.package.jar.enabled>
                <skipITs>false</skipITs>
                <quarkus.native.enabled>true</quarkus.native.enabled>
            </properties>
        </profile>
    </profiles>
</project>

<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.qubership.integration.platform</groupId>
        <artifactId>qip-parent-quarkus</artifactId>
        <version>1.7.1-SNAPSHOT</version>
        <relativePath>../parents/quarkus/pom.xml</relativePath>
    </parent>

    <artifactId>qip-ai-service</artifactId>
    <version>${revision}${changelist}</version>
    <name>QIP AI Service</name>
    <description>Quarkus AI service for QIP chain design, planning, and catalog implementation</description>

    <properties>
        <revision>1.6.1</revision>
        <changelist>-token-ref-2-SNAPSHOT</changelist>

        <maven.compiler.release>21</maven.compiler.release>
        <quarkus.platform.version>3.33.3</quarkus.platform.version>
        <a2a.version>1.1.0.Final</a2a.version>
        <!-- Flow 0.14.0 and Quarkus LangChain4j 1.12.2 target the Quarkus 3.33 LTS line. -->
        <quarkus-flow.version>0.14.0</quarkus-flow.version>
        <quarkus-langchain4j.version>1.12.2</quarkus-langchain4j.version>
        <skipITs>true</skipITs>
        <wiremock.version>3.10.0</wiremock.version>
        <groovy.version>4.0.30</groovy.version>
        <camel.version>4.18.2</camel.version>
        <sonar.coverage.jacoco.xmlReportPaths>${project.basedir}/target/site/jacoco/jacoco.xml</sonar.coverage.jacoco.xmlReportPaths>
        <qip.schemas.sync.skip>false</qip.schemas.sync.skip>
        <qip.schemas.local.dir>${project.basedir}/../schemas/src/main/resources/conf-model</qip.schemas.local.dir>
        <qip.schemas.download.url>
            https://github.com/Netcracker/qubership-integration-schemas/archive/refs/heads/main.tar.gz
        </qip.schemas.download.url>
        <qip.ai.qipknowledge.build.skip>true</qip.ai.qipknowledge.build.skip>
        <qip.ai.qipknowledge.pack-root>${project.basedir}/../.private/rocky-skills</qip.ai.qipknowledge.pack-root>
        <qip.knowledge.export>${project.basedir}/../.private/rocky-knowledge</qip.knowledge.export>
        <qip.ai.qipknowledge.skill-metadata-root>${qip.ai.qipknowledge.pack-root}/runtime</qip.ai.qipknowledge.skill-metadata-root>
        <qip.ai.qipknowledge.knowledge-overlay></qip.ai.qipknowledge.knowledge-overlay>
        <qip.ai.qipknowledge.output-root>${project.build.outputDirectory}/qipknowledge</qip.ai.qipknowledge.output-root>
        <qip.test.pack-root>${project.build.directory}/public-pack-fixture/integration-platform-skills</qip.test.pack-root>
        <qip.test.excluded-groups>certified-pack,server-restart</qip.test.excluded-groups>
        <qip.test.groups></qip.test.groups>
        <qip.ai.dbaas.agent.enabled>false</qip.ai.dbaas.agent.enabled>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- The parent imports quarkus-bom too, but a parent's imports follow the ones below, and the a2a SDK
                 BOM manages Quarkus 3.36.3. The first import of an artifact wins, so this one keeps every Quarkus
                 artifact on quarkus.platform.version. -->
            <dependency>
                <groupId>${quarkus.platform.group-id}</groupId>
                <artifactId>${quarkus.platform.artifact-id}</artifactId>
                <version>${quarkus.platform.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>io.quarkiverse.langchain4j</groupId>
                <artifactId>quarkus-langchain4j-bom</artifactId>
                <version>${quarkus-langchain4j.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>${quarkus.platform.group-id}</groupId>
                <artifactId>quarkus-amazon-services-bom</artifactId>
                <version>${quarkus.platform.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.a2aproject.sdk</groupId>
                <artifactId>a2a-java-sdk-bom</artifactId>
                <version>${a2a.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.apache.camel</groupId>
            <artifactId>camel-core-engine</artifactId>
            <version>${camel.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.camel</groupId>
            <artifactId>camel-core-languages</artifactId>
            <version>${camel.version}</version>
        </dependency>
        <dependency>
            <groupId>com.networknt</groupId>
            <artifactId>json-schema-validator</artifactId>
            <version>1.5.4</version>
        </dependency>
        <!-- Quarkus core -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-arc</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-rest</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-rest-jackson</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.dataformat</groupId>
            <artifactId>jackson-dataformat-yaml</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-smallrye-context-propagation</artifactId>
        </dependency>

        <!-- Workflow orchestration; product-pipeline execution remains on the legacy runtime. -->
        <dependency>
            <groupId>io.quarkiverse.flow</groupId>
            <artifactId>quarkus-flow</artifactId>
            <version>${quarkus-flow.version}</version>
        </dependency>
        <dependency>
            <groupId>io.quarkiverse.flow</groupId>
            <artifactId>quarkus-flow-jpa</artifactId>
            <version>${quarkus-flow.version}</version>
        </dependency>

        <!-- LangChain4j / Quarkus LangChain4j -->
        <dependency>
            <groupId>io.quarkiverse.langchain4j</groupId>
            <artifactId>quarkus-langchain4j-openai</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkiverse.langchain4j</groupId>
            <artifactId>quarkus-langchain4j-anthropic</artifactId>
        </dependency>
        <dependency>
            <groupId>com.knuddels</groupId>
            <artifactId>jtokkit</artifactId>
            <version>1.1.0</version>
        </dependency>

        <!-- REST Client for MCP tools -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-rest-client-jackson</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-smallrye-fault-tolerance</artifactId>
        </dependency>

        <!-- Validation -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-hibernate-validator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-cache</artifactId>
        </dependency>
        <dependency>
            <groupId>org.commonmark</groupId>
            <artifactId>commonmark</artifactId>
            <version>0.24.0</version>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.groovy</groupId>
            <artifactId>groovy</artifactId>
            <version>${groovy.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.groovy</groupId>
            <artifactId>groovy-json</artifactId>
            <version>${groovy.version}</version>
        </dependency>

        <!-- Health check -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-smallrye-health</artifactId>
        </dependency>

        <!-- Micrometer metrics (ADR 0003 P5 capture failure counters) -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-micrometer-registry-prometheus</artifactId>
        </dependency>

        <!-- S3-compatible object storage (MinIO) -->
        <dependency>
            <groupId>io.quarkiverse.amazonservices</groupId>
            <artifactId>quarkus-amazon-s3</artifactId>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>url-connection-client</artifactId>
        </dependency>

        <!-- A2A SDK compatibility probe (prompt 01) -->
        <dependency>
            <groupId>org.a2aproject.sdk</groupId>
            <artifactId>a2a-java-sdk-reference-rest</artifactId>
            <version>${a2a.version}</version>
        </dependency>
        <!--
            JSON-RPC for peers whose client is JSON-RPC only (DCA, Netcracker). The multiversion
            module dispatches POST / on the A2A-Version header: "1.0" speaks SendMessage, "0.3"
            speaks message/send, and a request without the header defaults to 0.3. Python
            a2a-sdk sends message/send and no header, so it lands on the 0.3 handler.
        -->
        <dependency>
            <groupId>org.a2aproject.sdk</groupId>
            <artifactId>a2a-java-sdk-reference-multiversion-jsonrpc</artifactId>
            <version>${a2a.version}</version>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-security</artifactId>
        </dependency>

        <!-- A2A Task persistence (prompt 02): application-owned JDBC + Flyway -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-jdbc-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-agroal</artifactId>
        </dependency>

        <!-- Cloud Core: DBaaS, Consul config, tenant context -->
        <dependency>
            <groupId>com.netcracker.cloud.quarkus</groupId>
            <artifactId>dbaas-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.netcracker.cloud.quarkus</groupId>
            <artifactId>dbaas-datasource-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>com.netcracker.cloud.quarkus</groupId>
            <artifactId>consul-config-source</artifactId>
        </dependency>
        <dependency>
            <groupId>com.netcracker.cloud.quarkus</groupId>
            <artifactId>framework-contexts</artifactId>
        </dependency>
        <dependency>
            <groupId>com.netcracker.cloud.quarkus</groupId>
            <artifactId>context-propagation</artifactId>
        </dependency>

        <!-- Testing -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit-mockito</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.wiremock</groupId>
            <artifactId>wiremock</artifactId>
            <version>${wiremock.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>5.17.0</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>${quarkus.platform.group-id}</groupId>
                <artifactId>quarkus-maven-plugin</artifactId>
                <version>${quarkus.platform.version}</version>
                <extensions>true</extensions>
                <executions>
                    <execution>
                        <goals>
                            <goal>build</goal>
                            <goal>generate-code</goal>
                            <goal>generate-code-tests</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <systemProperties>
                        <qip.ai.dbaas.agent.enabled>${qip.ai.dbaas.agent.enabled}</qip.ai.dbaas.agent.enabled>
                    </systemProperties>
                </configuration>
            </plugin>
            <plugin>
                <groupId>io.smallrye</groupId>
                <artifactId>jandex-maven-plugin</artifactId>
                <version>3.3.0</version>
                <executions>
                    <execution>
                        <id>make-index</id>
                        <goals>
                            <goal>jandex</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <parameters>true</parameters>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>generate-test-pack</id>
                        <phase>process-test-classes</phase>
                        <goals><goal>java</goal></goals>
                        <configuration>
                            <skip>${maven.test.skip}</skip>
                            <classpathScope>test</classpathScope>
                            <mainClass>org.qubership.integration.platform.ai.qipknowledge.pack.PublicCipKnowledgePackFixture</mainClass>
                            <arguments>
                                <argument>${project.build.directory}/public-pack-fixture</argument>
                                <argument>${project.build.testOutputDirectory}/qipknowledge</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>generate-qip-knowledge-indexes</id>
                        <phase>process-classes</phase>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <skip>${qip.ai.qipknowledge.build.skip}</skip>
                            <mainClass>org.qubership.integration.platform.ai.qipknowledge.pack.CipKnowledgePackBuildGenerator</mainClass>
                            <classpathScope>compile</classpathScope>
                            <arguments>
                                <argument>${qip.ai.qipknowledge.pack-root}</argument>
                                <argument>${qip.ai.qipknowledge.output-root}</argument>
                            </arguments>
                            <systemProperties>
                                <systemProperty>
                                    <key>qip.knowledge.export</key>
                                    <value>${qip.knowledge.export}</value>
                                </systemProperty>
                                <systemProperty>
                                    <key>qip.ai.qipknowledge.skill-metadata-root</key>
                                    <value>${qip.ai.qipknowledge.skill-metadata-root}</value>
                                </systemProperty>
                            </systemProperties>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <execution>
                        <id>stage-certified-knowledge-export</id>
                        <phase>process-classes</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <skip>${qip.ai.qipknowledge.build.skip}</skip>
                            <outputDirectory>${project.build.directory}/knowledge-runtime</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${qip.knowledge.export}</directory>
                                </resource>
                            </resources>
                            <overwrite>true</overwrite>
                        </configuration>
                    </execution>
                    <execution>
                        <id>stage-rocky-source-manifest</id>
                        <phase>process-resources</phase>
                        <goals><goal>copy-resources</goal></goals>
                        <configuration>
                            <skip>${qip.ai.qipknowledge.build.skip}</skip>
                            <outputDirectory>${project.build.outputDirectory}/META-INF/rocky-skills</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${qip.ai.qipknowledge.pack-root}</directory>
                                    <includes><include>manifest.json</include><include>skills/**/SKILL.md</include></includes>
                                </resource>
                            </resources>
                            <overwrite>true</overwrite>
                        </configuration>
                    </execution>
                    <execution>
                        <id>stage-rocky-product-pipelines</id>
                        <phase>process-resources</phase>
                        <goals><goal>copy-resources</goal></goals>
                        <configuration>
                            <skip>${qip.ai.qipknowledge.build.skip}</skip>
                            <outputDirectory>${project.build.outputDirectory}/product-pipelines</outputDirectory>
                            <resources><resource>
                                <directory>${qip.ai.qipknowledge.pack-root}/runtime/product-pipelines</directory>
                            </resource></resources>
                            <overwrite>true</overwrite>
                        </configuration>
                    </execution>
                    <execution>
                        <id>overlay-qip-schemas-into-classes</id>
                        <phase>process-classes</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <skip>${qip.schemas.sync.skip}</skip>
                            <outputDirectory>${project.build.outputDirectory}/qip-schemas</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.build.directory}/qip-schemas-staging/qip-schemas</directory>
                                </resource>
                            </resources>
                            <overwrite>true</overwrite>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.gmaven</groupId>
                <artifactId>groovy-maven-plugin</artifactId>
                <version>2.1.1</version>
                <executions>
                    <execution>
                        <id>fetch-qip-schemas</id>
                        <phase>generate-resources</phase>
                        <goals><goal>execute</goal></goals>
                        <configuration>
                            <source>${project.basedir}/scripts/fetch-qip-schemas.groovy</source>
                        </configuration>
                    </execution>
                    <execution>
                        <id>clear-private-build-output</id>
                        <phase>initialize</phase>
                        <goals><goal>execute</goal></goals>
                        <configuration>
                            <source>${project.basedir}/scripts/clear-private-build-output.groovy</source>
                        </configuration>
                    </execution>
                    <execution>
                        <id>merge-system-prompts</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>execute</goal>
                        </goals>
                        <configuration>
                            <source>${project.basedir}/scripts/merge-system-prompts.groovy</source>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <!-- A named execution: the parent's unnamed `list` execution would otherwise absorb this goal
                         and move it to prepare-package, after surefire reads the Mockito path it sets. -->
                    <execution>
                        <id>dependency-properties</id>
                        <goals>
                            <goal>properties</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- Attach Mockito as a Java agent so the inline mock maker works on Java 21
                         without local -Dnet.bytebuddy.experimental / self-attach workarounds. -->
                    <excludedGroups>${qip.test.excluded-groups}</excludedGroups>
                    <groups>${qip.test.groups}</groups>
                    <argLine>@{argLine} -javaagent:${org.mockito:mockito-core:jar}</argLine>
                    <includes>
                        <include>**/*Test.java</include>
                        <include>**/*IT.java</include>
                    </includes>
                    <systemPropertyVariables>
                        <qip.test.pack-root>${qip.test.pack-root}</qip.test.pack-root>
                        <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
                        <maven.home>${maven.home}</maven.home>
                        <tenant.default.id>default</tenant.default.id>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-gpg-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>certified-pack-tests</id>
            <properties>
                <qip.test.pack-root>${project.basedir}/../.private/rocky-skills</qip.test.pack-root>

                <qip.test.excluded-groups></qip.test.excluded-groups>
                <qip.test.groups>certified-pack</qip.test.groups>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>generate-test-pack</id>
                                <configuration>
                                    <mainClass>org.qubership.integration.platform.ai.qipknowledge.pack.CipKnowledgePackBuildGenerator</mainClass>
                                    <arguments combine.self="override">
                                        <argument>${qip.test.pack-root}</argument>
                                        <argument>${project.build.testOutputDirectory}/qipknowledge</argument>
                                    </arguments>
                                    <systemProperties>
                                        <systemProperty>
                                            <key>qip.knowledge.export</key>
                                    <value>${qip.knowledge.export}</value>
                                </systemProperty>
                                <systemProperty>
                                    <key>qip.ai.qipknowledge.skill-metadata-root</key>
                                            <value>${qip.test.pack-root}/runtime</value>
                                        </systemProperty>
                                    </systemProperties>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>schemas-from-download</id>
            <properties>
                <qip.schemas.local.dir></qip.schemas.local.dir>
            </properties>
        </profile>
        <profile>
            <id>with-rocky-skills</id>

            <properties>
                <qip.ai.qipknowledge.build.skip>false</qip.ai.qipknowledge.build.skip>
                <qip.ai.qipknowledge.pack-root>${project.basedir}/../.private/rocky-skills</qip.ai.qipknowledge.pack-root>
                <qip.ai.qipknowledge.skill-metadata-root>${qip.ai.qipknowledge.pack-root}/runtime</qip.ai.qipknowledge.skill-metadata-root>
            </properties>
        </profile>
        <profile>
            <id>native</id>
            <activation>
                <property>
                    <name>native</name>
                </property>
            </activation>
            <properties>
                <quarkus.package.jar.enabled>false</quarkus.package.jar.enabled>
                <skipITs>false</skipITs>
                <quarkus.native.enabled>true</quarkus.native.enabled>
            </properties>
        </profile>
    </profiles>
</project>

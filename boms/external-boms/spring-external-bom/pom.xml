<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.qubership.integration.platform</groupId>
    <artifactId>qip-parent-spring</artifactId>
    <version>1.5.1-SNAPSHOT</version>
    <relativePath>../../../parents/spring/pom.xml</relativePath>
  </parent>

  <artifactId>qip-spring-external-bom</artifactId>
  <packaging>pom</packaging>

  <name>QIP External BOM - Spring Boot</name>
  <description>External BOM for Spring Boot based QIP modules.</description>

  <properties>
    <qip.integration-build-pipeline.version>1.5.1-SNAPSHOT</qip.integration-build-pipeline.version>
    <qip.integration-build-maven-plugin.version>1.5.1-SNAPSHOT</qip.integration-build-maven-plugin.version>
    <qip.engine.version>1.5.1-SNAPSHOT</qip.engine.version>
    <qip.runtime-catalog.version>1.5.1-SNAPSHOT</qip.runtime-catalog.version>
    <qip.sessions-management.version>1.5.1-SNAPSHOT</qip.sessions-management.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.qubership.integration.platform</groupId>
        <artifactId>qip-integration-build-pipeline</artifactId>
        <version>${qip.integration-build-pipeline.version}</version>
      </dependency>
      <dependency>
        <groupId>org.qubership.integration.platform</groupId>
        <artifactId>qip-integration-build-maven-plugin</artifactId>
        <version>${qip.integration-build-maven-plugin.version}</version>
      </dependency>
      <dependency>
        <groupId>org.qubership.integration.platform</groupId>
        <artifactId>qip-engine</artifactId>
        <version>${qip.engine.version}</version>
      </dependency>
      <dependency>
        <groupId>org.qubership.integration.platform</groupId>
        <artifactId>qip-runtime-catalog</artifactId>
        <version>${qip.runtime-catalog.version}</version>
      </dependency>
      <dependency>
        <groupId>org.qubership.integration.platform</groupId>
        <artifactId>qip-sessions-management</artifactId>
        <version>${qip.sessions-management.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>
</project>

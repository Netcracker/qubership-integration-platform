# QIP AI Service (Quarkus) — local compose profile `ai`
# Copy to .env.local or export secrets before: docker compose --profile ai up

# Placeholder required: empty env values fail Quarkus config converters at startup.
APIHUB_MCP_API_KEY=test
APIHUB_MCP_URL=http://127.0.0.1:9
CATALOG_TOKEN=
CATALOG_URL=http://runtime-catalog:8080
CHAT_MEMORY_MAX_TOKENS=24000
LLM_API_KEY=dev-placeholder
LLM_BASE_URL=https://api.openai.com/v1
LLM_CHAT_MODEL=gpt-4o-mini
LLM_EMBEDDING_MODEL=text-embedding-3-small
LLM_MAX_TOKENS=4096
LLM_REASONING_EFFORT=none
LLM_TEMPERATURE=0.2
LLM_TIMEOUT=180s
MINIO_ACCESS_KEY=minioadmin
MINIO_ENDPOINT=http://minio:9000
MINIO_SECRET_KEY=minioadmin
QIP_CREATE_PRODUCT_PROFILE_ID=create-chain
QIP_CREATE_PRODUCT_PROFILE_VERSION=1
QIP_CREATE_RUNTIME=product
# Enable the evidence snapshot API for local tests.
QIP_EVIDENCE_SNAPSHOT_ENABLED=true
QUARKUS_HTTP_PORT=8080
TENANT_DEFAULT_ID=default
# Create the bucket on startup when MinIO is reachable.
STORAGE_INIT_BUCKET_ON_STARTUP=true

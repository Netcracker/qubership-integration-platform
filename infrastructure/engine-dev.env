DYNAMIC_ENGINE_CONSUL_STATE_ENABLED=true
KUBE_DEV_MODE=true
POSTGRES_URL=postgres:5432
# Endpoint mocking, off by default: with it on, every outbound HTTP call with no
# matching mock gets a 404, which breaks the local stack for everyone else. To use
# it for a session, set the flag to true and restart the engine:
# docker compose -f infrastructure/docker-compose.yml up -d qip-engine
TESTING_SERVICE_ENABLED=false
TESTING_SERVICE_ADDRESS=http://testing-service:8080

DYNAMIC_ENGINE_CONSUL_STATE_ENABLED=true
KUBE_DEV_MODE=true
POSTGRES_URL=postgres:5432
# Endpoint mocking. With it on, an outbound HTTP call of a test case run goes to
# the testing service, and one with no matching mock gets a 404 instead of
# reaching the real endpoint. A run the testing service did not start reaches the
# real endpoint as usual. Set the flag to false and restart the engine to turn it
# off: docker compose -f infrastructure/docker-compose.yml up -d qip-engine
TESTING_SERVICE_ADDRESS=http://testing-service:8080
TESTING_SERVICE_ENABLED=true

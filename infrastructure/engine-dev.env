DYNAMIC_ENGINE_CONSUL_STATE_ENABLED=true
KUBE_DEV_MODE=true
POSTGRES_URL=postgres:5432
# Endpoint mocking. With it on, an outbound HTTP call with no matching mock gets
# a 404 instead of reaching the real endpoint, so a chain that calls a live
# service needs a mock for it. Set the flag to false and restart the engine to
# turn it off: docker compose -f infrastructure/docker-compose.yml up -d qip-engine
TESTING_SERVICE_ADDRESS=http://testing-service:8080
TESTING_SERVICE_ENABLED=true

<route>
    <step id="c8925e95-954c-439a-bb63-572a9a350d5c">
        <doTry>
            <process ref="contextPropagationProcessor"/>

            <toD uri="http://localhost:8080?from=from@example.com&amp;to=to@example.com&amp;replyTo=reply-to@example.com&amp;cc=copy-to@example.com&amp;bcc=copy-to@example.com&amp;subject=Test mail&amp;username=user&amp;password=user&amp;connectionTimeout=30000&amp;contentType=text/plain&amp;useInlineAttachments=false&amp;ignoreUnsupportedCharset=true"/>

            <doCatch>
                <exception>jakarta.mail.MessagingException</exception>
                <setBody>
                    <simple>${exchangeProperty.CamelExceptionCaught.message}</simple>
                </setBody>
                <process ref="throwCaughtExceptionProcessor"/>
            </doCatch>
            <doFinally>
                <removeProperty name="internalProperty_overrideContextParams"/>
                <process ref="contextRestoreProcessor"/>
            </doFinally>
        </doTry>
    </step>

</route>

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Micro-engine snapshot test specification",
  "description": "Editor assistance for manifest structure. Java validates deployment references, providers, selectors, matchers, and execution semantics.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "subject": {
      "anyOf": [
        {
          "$ref": "#/definitions/nonblankString"
        },
        {
          "type": "null"
        }
      ]
    },
    "deployments": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "$ref": "#/definitions/deployment"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "resources": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "$ref": "#/definitions/resource"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "fixtures": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "$ref": "#/definitions/fixture"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "scenarios": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/scenario"
      },
      "minItems": 1
    }
  },
  "required": [
    "scenarios"
  ],
  "allOf": [
    {
      "if": {
        "required": [
          "deployments"
        ],
        "properties": {
          "deployments": {
            "type": "array",
            "minItems": 1
          }
        }
      },
      "then": {
        "required": [
          "subject"
        ],
        "properties": {
          "subject": {
            "$ref": "#/definitions/nonblankString"
          }
        }
      },
      "else": {
        "properties": {
          "subject": {
            "type": "null"
          }
        }
      }
    }
  ],
  "definitions": {
    "nonblankString": {
      "type": "string",
      "pattern": "\\S"
    },
    "valueMap": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "headerNames": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/definitions/nonblankString"
      }
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/definitions/nonblankString"
        },
        "route": {
          "allOf": [
            {
              "$ref": "#/definitions/nonblankString"
            }
          ],
          "description": "Chain name in the generated snapshot bundle."
        },
        "snapshotVariant": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
          "description": "Named generated bundle under variants/, such as scheduler-second for a second snapshot of the same chain."
        },
        "isolatedContext": {
          "type": "boolean",
          "default": false,
          "description": "Load this deployment in a separate Camel context for overlapping consumer lifecycle checks."
        },
        "dependsOn": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/definitions/nonblankString"
          }
        }
      },
      "required": [
        "id",
        "route"
      ]
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": {
          "$ref": "#/definitions/nonblankString"
        },
        "target": {
          "$ref": "#/definitions/nonblankString"
        }
      },
      "required": [
        "source",
        "target"
      ]
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/definitions/nonblankString"
        },
        "provider": {
          "allOf": [
            {
              "$ref": "#/definitions/nonblankString"
            }
          ],
          "description": "Fixture provider identifier. Available providers are registered in Java."
        },
        "deployment": {
          "anyOf": [
            {
              "$ref": "#/definitions/nonblankString"
            },
            {
              "type": "null"
            }
          ]
        },
        "nodeId": {
          "anyOf": [
            {
              "$ref": "#/definitions/nonblankString"
            },
            {
              "type": "null"
            }
          ]
        },
        "sourceElementId": {
          "anyOf": [
            {
              "$ref": "#/definitions/nonblankString"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "provider"
      ]
    },
    "driver": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": {
          "allOf": [
            {
              "$ref": "#/definitions/nonblankString"
            }
          ],
          "description": "Driver provider identifier, such as http-trigger, rabbitmq-trigger, sftp-trigger, mcp-trigger, scheduler, file-read, or route-selector."
        },
        "sourceElementId": {
          "anyOf": [
            {
              "$ref": "#/definitions/nonblankString"
            },
            {
              "type": "null"
            }
          ]
        },
        "parameters": {
          "allOf": [
            {
              "$ref": "#/definitions/valueMap"
            }
          ],
          "description": "Provider-specific parameters. Java validates their names and values."
        }
      },
      "required": [
        "provider"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "provider": { "const": "rabbitmq-trigger" }
            },
            "required": ["provider"]
          },
          "then": {
            "properties": {
              "parameters": { "$ref": "#/definitions/rabbitmqTriggerDriverParameters" }
            }
          }
        },
        {
          "if": {
            "properties": {
              "provider": { "const": "sftp-trigger" }
            },
            "required": ["provider"]
          },
          "then": {
            "properties": {
              "parameters": { "$ref": "#/definitions/sftpTriggerDriverParameters" }
            }
          }
        },
        {
          "if": {
            "properties": { "provider": { "const": "mcp-trigger" } },
            "required": ["provider"]
          },
          "then": {
            "properties": {
              "parameters": { "$ref": "#/definitions/mcpTriggerDriverParameters" }
            }
          }
        },
        {
          "if": {
            "properties": { "provider": { "const": "scheduler" } },
            "required": ["provider"]
          },
          "then": {
            "properties": {
              "parameters": { "$ref": "#/definitions/schedulerDriverParameters" }
            }
          }
        }
      ]
    },
    "schedulerDriverParameters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "nodeId": { "$ref": "#/definitions/nonblankString" }
      }
    },
    "mcpTriggerDriverParameters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "nodeId": { "$ref": "#/definitions/nonblankString" },
        "operation": { "enum": ["call", "list", "concurrent"] },
        "toolName": { "$ref": "#/definitions/nonblankString" },
        "parallelArguments": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "object" }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "operation": { "const": "concurrent" } },
            "required": ["operation"]
          },
          "then": { "required": ["parallelArguments"] }
        }
      ]
    },
    "sftpTriggerDriverParameters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "nodeId": { "$ref": "#/definitions/nonblankString" },
        "fileName": { "$ref": "#/definitions/nonblankString" },
        "bodyBase64": { "type": "string" },
        "bodyRepeat": { "type": "integer", "minimum": 1 },
        "mtimeSeconds": { "type": "integer", "minimum": 0 },
        "publish": { "type": "boolean" },
        "expectedCompletions": { "type": "integer", "minimum": 0 },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/sftpTriggerFile" }
        }
      }
    },
    "sftpTriggerFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fileName"],
      "properties": {
        "fileName": { "$ref": "#/definitions/nonblankString" },
        "body": { "type": "string" },
        "bodyBase64": { "type": "string" },
        "bodyRepeat": { "type": "integer", "minimum": 1 },
        "mtimeSeconds": { "type": "integer", "minimum": 0 }
      }
    },
    "rabbitmqTriggerDriverParameters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "nodeId": { "$ref": "#/definitions/nonblankString" },
        "exchange": { "type": "string" },
        "routingKey": { "type": "string" },
        "amqpProperties": { "$ref": "#/definitions/valueMap" },
        "headersBase64": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "description": "Binary AMQP user headers encoded as base64."
        },
        "bodyBase64": { "type": "string" },
        "bodyRepeat": { "type": "integer", "minimum": 1 },
        "expectedCompletions": { "type": "integer", "minimum": 0 },
        "messages": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/rabbitmqTriggerPublication" }
        }
      }
    },
    "rabbitmqTriggerPublication": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "body": {},
        "headers": { "$ref": "#/definitions/valueMap" },
        "headersBase64": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "exchange": { "type": "string" },
        "routingKey": { "type": "string" },
        "amqpProperties": { "$ref": "#/definitions/valueMap" },
        "bodyBase64": { "type": "string" },
        "bodyRepeat": { "type": "integer", "minimum": 1 }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reuseBroker": {
          "type": "boolean",
          "default": false,
          "description": "Reuse a compatible worker-owned broker while creating fresh routes and clients for this scenario."
        },
        "id": {
          "$ref": "#/definitions/nonblankString"
        },
        "expectedStartupFailure": {
          "$ref": "#/definitions/failure",
          "description": "Expected deployment startup failure. The runner checks its type, message, and cause chain, then closes the environment without executing invocations."
        },
        "scope": {
          "type": "string",
          "enum": [
            "Long",
            "Short"
          ]
        },
        "deployment": {
          "anyOf": [
            {
              "$ref": "#/definitions/nonblankString"
            },
            {
              "type": "null"
            }
          ],
          "description": "Subject deployment for this scenario. Includes its transitive dependencies; omission loads all declared deployments."
        },
        "endpointUri": {
          "anyOf": [
            {
              "$ref": "#/definitions/nonblankString"
            },
            {
              "type": "null"
            }
          ],
          "description": "Camel endpoint URI. Set this or driver, not both."
        },
        "driver": {
          "anyOf": [
            {
              "$ref": "#/definitions/driver"
            },
            {
              "type": "null"
            }
          ]
        },
        "body": {
          "description": "Input payload. Strings, structured values, and null are supported."
        },
        "headers": {
          "$ref": "#/definitions/valueMap"
        },
        "properties": {
          "allOf": [
            {
              "$ref": "#/definitions/valueMap"
            }
          ],
          "description": "Input Camel exchange properties. The HTTP driver does not accept these."
        },
        "expectedBody": {
          "description": "Expected body or matcher. Omit to skip the assertion; null asserts a null body."
        },
        "expectedHeaders": {
          "allOf": [
            {
              "$ref": "#/definitions/valueMap"
            }
          ],
          "description": "Result headers. Values use exact equality or {\"$match\": \"non-empty\"} to require a nonblank string or a collection containing one. For HTTP, these are the received response headers; CamelHttpResponseCode holds the status."
        },
        "expectedAbsentHeaders": {
          "allOf": [
            {
              "$ref": "#/definitions/headerNames"
            }
          ],
          "description": "Headers that must be absent from the result. HTTP assertions inspect the received response."
        },
        "expectedExchangeHeaders": {
          "allOf": [
            {
              "$ref": "#/definitions/valueMap"
            }
          ],
          "description": "Internal Camel exchange headers, separate from HTTP response headers."
        },
        "expectedAbsentExchangeHeaders": {
          "allOf": [
            {
              "$ref": "#/definitions/headerNames"
            }
          ],
          "description": "Headers that must be absent from the internal Camel exchange."
        },
        "expectedProperties": {
          "allOf": [
            {
              "$ref": "#/definitions/valueMap"
            }
          ],
          "description": "Expected internal Camel exchange properties."
        },
        "interactions": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/definitions/interaction"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "invocations": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/definitions/invocation"
              },
              "minItems": 1,
              "description": "Ordered invocations sharing one scenario runtime and fixture state."
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "scope"
      ],
      "allOf": [
        {
          "oneOf": [
            {
              "required": [
                "endpointUri"
              ],
              "properties": {
                "endpointUri": {
                  "$ref": "#/definitions/nonblankString"
                },
                "driver": {
                  "type": "null"
                }
              }
            },
            {
              "required": [
                "driver"
              ],
              "properties": {
                "driver": {
                  "$ref": "#/definitions/driver"
                },
                "endpointUri": {
                  "type": "null"
                }
              }
            }
          ]
        },
        {
          "if": {
            "required": [
              "invocations"
            ],
            "properties": {
              "invocations": {
                "type": "array"
              }
            }
          },
          "then": {
            "properties": {
              "body": {
                "type": "null"
              },
              "headers": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "object",
                    "maxProperties": 0
                  }
                ]
              },
              "properties": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "object",
                    "maxProperties": 0
                  }
                ]
              },
              "expectedHeaders": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "object",
                    "maxProperties": 0
                  }
                ]
              },
              "expectedProperties": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "object",
                    "maxProperties": 0
                  }
                ]
              },
              "expectedExchangeHeaders": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "object",
                    "maxProperties": 0
                  }
                ]
              },
              "expectedAbsentHeaders": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "array",
                    "maxItems": 0
                  }
                ]
              },
              "expectedAbsentExchangeHeaders": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "array",
                    "maxItems": 0
                  }
                ]
              },
              "interactions": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "array",
                    "maxItems": 0
                  }
                ]
              }
            },
            "not": {
              "required": [
                "expectedBody"
              ]
            },
            "description": "Put input, expectations, and interactions inside each explicit invocation."
          }
        }
      ]
    },
    "invocation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/definitions/nonblankString"
        },
        "endpointUri": {
          "anyOf": [
            {
              "$ref": "#/definitions/nonblankString"
            },
            {
              "type": "null"
            }
          ],
          "description": "Camel endpoint URI. Set this or driver, not both."
        },
        "driver": {
          "anyOf": [
            {
              "$ref": "#/definitions/driver"
            },
            {
              "type": "null"
            }
          ]
        },
        "body": {
          "description": "Input payload. Strings, structured values, and null are supported."
        },
        "headers": {
          "$ref": "#/definitions/valueMap"
        },
        "properties": {
          "allOf": [
            {
              "$ref": "#/definitions/valueMap"
            }
          ],
          "description": "Input Camel exchange properties. The HTTP driver does not accept these."
        },
        "expectedBody": {
          "description": "Expected body or matcher. Omit to skip the assertion; null asserts a null body."
        },
        "expectedHeaders": {
          "allOf": [
            {
              "$ref": "#/definitions/valueMap"
            }
          ],
          "description": "Result headers. Values use exact equality or {\"$match\": \"non-empty\"} to require a nonblank string or a collection containing one. For HTTP, these are the received response headers; CamelHttpResponseCode holds the status."
        },
        "expectedAbsentHeaders": {
          "allOf": [
            {
              "$ref": "#/definitions/headerNames"
            }
          ],
          "description": "Headers that must be absent from the result. HTTP assertions inspect the received response."
        },
        "expectedExchangeHeaders": {
          "allOf": [
            {
              "$ref": "#/definitions/valueMap"
            }
          ],
          "description": "Internal Camel exchange headers, separate from HTTP response headers."
        },
        "expectedAbsentExchangeHeaders": {
          "allOf": [
            {
              "$ref": "#/definitions/headerNames"
            }
          ],
          "description": "Headers that must be absent from the internal Camel exchange."
        },
        "expectedProperties": {
          "allOf": [
            {
              "$ref": "#/definitions/valueMap"
            }
          ],
          "description": "Expected internal Camel exchange properties."
        },
        "interactions": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/definitions/interaction"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "repeat": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "default": 1
        },
        "timeoutSeconds": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "description": "Overrides the shared invocation timeout for setup, all repeats, and verification. Omitted or null values use route.contract.invocation.timeout.seconds, which defaults to 30 seconds."
        },
        "expectedFailure": {
          "allOf": [
            {
              "$ref": "#/definitions/failure"
            }
          ],
          "description": "Exception type, message, and complete cause chain, with explicit alternatives or ignored messages when needed. Omit when execution must succeed."
        }
      },
      "required": [
        "id"
      ],
      "not": {
        "required": [
          "endpointUri",
          "driver"
        ],
        "properties": {
          "endpointUri": {
            "type": "string"
          },
          "driver": {
            "type": "object"
          }
        }
      }
    },
    "failure": {
      "oneOf": [
        {
          "$ref": "#/definitions/singleFailure"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "anyOf": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/definitions/failure"
              }
            }
          },
          "required": [
            "anyOf"
          ]
        }
      ]
    },
    "singleFailure": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "$ref": "#/definitions/nonblankString"
        },
        "message": {
          "type": [
            "string",
            "null"
          ]
        },
        "ignoreMessage": {
          "const": true,
          "description": "Skip message comparison for this exception only. Use instead of message."
        },
        "cause": {
          "anyOf": [
            {
              "$ref": "#/definitions/failure"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "type",
        "cause"
      ],
      "oneOf": [
        {
          "required": [
            "message"
          ]
        },
        {
          "required": [
            "ignoreMessage"
          ]
        }
      ]
    },
    "interaction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fixture": {
          "$ref": "#/definitions/nonblankString"
        },
        "response": {
          "anyOf": [
            {
              "$ref": "#/definitions/response"
            },
            {
              "type": "null"
            }
          ]
        },
        "expectedRequest": {
          "anyOf": [
            {
              "$ref": "#/definitions/request"
            },
            {
              "type": "null"
            }
          ]
        },
        "expectedLogs": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/definitions/log"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "expectedExchanges": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/definitions/exchange"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "transitionToState": {
          "anyOf": [
            {
              "$ref": "#/definitions/nonblankString"
            },
            {
              "type": "null"
            }
          ]
        },
        "awaitState": {
          "description": "Circuit breaker state to observe before sending the invocation. Waits up to 10 seconds without changing the state.",
          "anyOf": [
            {
              "$ref": "#/definitions/nonblankString"
            },
            {
              "type": "null"
            }
          ]
        },
        "expectedState": {
          "anyOf": [
            {
              "$ref": "#/definitions/nonblankString"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "fixture"
      ],
      "anyOf": [
        {
          "required": [
            "response"
          ],
          "properties": {
            "response": {
              "type": "object"
            }
          }
        },
        {
          "required": [
            "expectedRequest"
          ],
          "properties": {
            "expectedRequest": {
              "type": "object"
            }
          }
        },
        {
          "required": [
            "expectedLogs"
          ],
          "properties": {
            "expectedLogs": {
              "type": "array"
            }
          }
        },
        {
          "required": [
            "expectedExchanges"
          ],
          "properties": {
            "expectedExchanges": {
              "type": "array"
            }
          }
        },
        {
          "required": [
            "transitionToState"
          ],
          "properties": {
            "transitionToState": {
              "type": "string"
            }
          }
        },
        {
          "required": [
            "awaitState"
          ],
          "properties": {
            "awaitState": {
              "type": "string"
            }
          }
        },
        {
          "required": [
            "expectedState"
          ],
          "properties": {
            "expectedState": {
              "type": "string"
            }
          }

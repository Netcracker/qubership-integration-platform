    "path": "payments.events",
    "method": "receive",
    "modelId": "bb9ab025-a7ec-4092-9780-650d44b52120-kafka-v3-comprehensive-2.0.0",
    "sourceHash": "4f470ec36a5e0b4771a7c76c901610c2988d19c39bb99d5d846da8c088c186c3",
    "operationId": "receivePaymentProcessed",
    "requestSchema": {
    },
    "specification": {
        "topic": "payments.events"
    },
    "responseSchemas": {
        "PaymentProcessed": {
            "$id": "http://system.catalog/schemas/PaymentProcessed",
            "type": "object",
            "$schema": "http://json-schema.org/draft-07/schema#",
            "required": [
                "paymentId",
                "amount",
                "currency",
                "status"
            ],
            "properties": {
                "amount": {
                    "type": "number",
                    "format": "double",
                    "minimum": 0
                },
                "method": {
                    "$ref": "#/definitions/PaymentMethod"
                },
                "status": {
                    "enum": [
                        "pending",
                        "completed",
                        "failed",
                        "refunded"
                    ],
                    "type": "string"
                },
                "currency": {
                    "type": "string",
                    "maxLength": 3,
                    "minLength": 3
                },
                "paymentId": {
                    "type": "string",
                    "format": "uuid"
                },
                "billingAddress": {
                    "$ref": "#/definitions/Address"
                }
            },
            "definitions": {
                "Address": {
                    "type": "object",
                    "properties": {
                        "city": {
                            "type": "string"
                        },
                        "street": {
                            "type": "string"
                        },
                        "country": {
                            "type": "string",
                            "maxLength": 2,
                            "minLength": 2
                        },
                        "postalCode": {
                            "type": "string"
                        }
                    }
                },
                "PaymentMethod": {
                    "type": "object",
                    "properties": {
                        "type": {
                            "enum": [
                                "card",
                                "bank_transfer",
                                "wallet"
                            ],
                            "type": "string"
                        },
                        "last4": {
                            "type": "string",
                            "pattern": "^\\d{4}$"
                        },
                        "provider": {
                            "type": "string"
                        }
                    }
                }
            }
        }
    }

{
    "typed": {
        "type": "openapi",
        "summary": "Direct multipart upload",
        "path": "/uploads",
        "method": "post",
        "isDeprecated": null
    },
    "path": "/uploads",
    "method": "POST",
    "modelId": "dc4cc3d4-83bc-46da-b536-7f5d41ba67c0-01-aperture-dam-3.1-2.4.0",
    "sourceHash": "899ecc3509273442ff0718c33f3ca2c3f5c227c1109eafdc985d64c535596514",
    "operationId": "uploadAsset",
    "requestSchema": {
        "multipart/form-data": {
            "type": "object",
            "required": [
                "file",
                "metadata"
            ],
            "properties": {
                "file": {
                    "type": "string",
                    "format": "binary"
                },
                "checksum": {
                    "type": "string",
                    "pattern": "^sha256:[A-Fa-f0-9]{64}$"
                },
                "metadata": {
                    "$ref": "#/components/schemas/UploadMetadata"
                }
            }
        }
    },
    "specification": {
        "tags": [
            "Uploads"
        ],
        "summary": "Direct multipart upload",
        "security": [
            {
                "oauth2ClientCreds": [
                    "assets.write"
                ]
            }
        ],
        "responses": {
            "201": {
                "content": {
                    "application/json": {
                        "schema": {
                            "$ref": "#/components/schemas/Asset"
                        }
                    }
                },
                "description": "Uploaded."
            }
        },
        "operationId": "uploadAsset",
        "requestBody": {
            "content": {
                "multipart/form-data": {
                    "schema": {
                        "type": "object",
                        "required": [
                            "file",
                            "metadata"
                        ],
                        "properties": {
                            "file": {
                                "type": "string",
                                "format": "binary"
                            },
                            "checksum": {
                                "type": "string",
                                "pattern": "^sha256:[A-Fa-f0-9]{64}$"
                            },
                            "metadata": {
                                "$ref": "#/components/schemas/UploadMetadata"
                            }
                        }
                    },
                    "encoding": {
                        "file": {
                            "style": "form",
                            "headers": {
                                "X-Content-Sha256": {
                                    "style": "simple",
                                    "schema": {
                                        "type": "string"
                                    },
                                    "explode": false
                                }
                            },
                            "contentType": "application/octet-stream"
                        },
                        "metadata": {
                            "style": "form",
                            "contentType": "application/json"
                        }
                    }
                }
            },
            "required": true
        }
    },
    "responseSchemas": {
        "201": {
            "application/json": {
                "$id": "http://system.catalog/schemas/#/components/schemas/Asset",
                "type": "object",
                "oneOf": [
                    {
                        "$ref": "#/definitions/ImageAsset"
                    },
                    {
                        "$ref": "#/definitions/VideoAsset"
                    },
                    {
                        "$ref": "#/definitions/AudioAsset"
                    },
                    {
                        "$ref": "#/definitions/DocumentAsset"
                    }
                ],
                "$schema": "http://json-schema.org/draft-07/schema#",
                "required": [
                    "kind"
                ],
                "definitions": {
                    "AssetBase": {
                        "type": "object",
                        "required": [
                            "createdAt",
                            "id",
                            "kind",
                            "status"
                        ],
                        "properties": {
                            "id": {
                                "type": "string",
                                "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
                                "readOnly": true
                            },
                            "kind": {
                                "$ref": "#/definitions/AssetKind"
                            },
                            "tags": {
                                "type": "array",
                                "items": {
                                    "type": "string"
                                },
                                "uniqueItems": true
                            },
                            "title": {
                                "type": [
                                    "string",
                                    "null"
                                ],
                                "maxLength": 255
                            },
                            "custom": {
                                "type": "object",
                                "description": "Arbitrary tenant metadata.",
                                "additionalProperties": true
                            },
                            "status": {
                                "enum": [
                                    "pending",
                                    "processing",
                                    "ready",
                                    "failed"
                                ],
                                "type": "string"
                            },
                            "checksums": {
                                "type": "object",
                                "propertyNames": {
                                    "enum": [
                                        "sha256",
                                        "md5",
                                        "crc32"
                                    ],
                                    "type": "string"
                                },
                                "additionalProperties": {
                                    "type": "string"
                                }
                            },
                            "createdAt": {
                                "type": "string",
                                "format": "date-time",
                                "readOnly": true
                            },
                            "updatedAt": {
                                "type": [
                                    "string",
                                    "null"
                                ],
                                "format": "date-time",
                                "readOnly": true
                            },
                            "notificationUrl": {
                                "type": [
                                    "string",
                                    "null"
                                ],
                                "format": "uri",
                                "description": "Where async callbacks are delivered."
                            }
                        },
                        "unevaluatedProperties": false
                    },
                    "AssetKind": {
                        "enum": [
                            "image",
                            "video",
                            "audio",
                            "document"
                        ],
                        "type": "string"
                    },
                    "AudioAsset": {
                        "allOf": [
                            {
                                "$ref": "#/definitions/AssetBase"
                            },
                            {
                                "type": "object",
                                "required": [
                                    "durationSeconds",
                                    "kind",
                                    "sampleRateHz"
                                ],
                                "properties": {
                                    "kind": {
                                        "const": "audio"
                                    },
                                    "channels": {
                                        "type": "integer",
                                        "maximum": 8,
                                        "minimum": 1
                                    },
                                    "sampleRateHz": {
                                        "enum": [
                                            44100,
                                            48000,
                                            96000,
                                            192000
                                        ],
                                        "type": "integer"
                                    },
                                    "durationSeconds": {
                                        "type": "number",
                                        "exclusiveMinimum": 0
                                    }
                                },
                                "unevaluatedProperties": false
                            }
                        ]
                    },
                    "AudioTrack": {
                        "type": "object",
                        "required": [
                            "codec",
                            "language"
                        ],
                        "properties": {
                            "codec": {
                                "enum": [
                                    "aac",
                                    "opus",
                                    "mp3",
                                    "flac"
                                ],
                                "type": "string"
                            },
                            "language": {
                                "type": "string",
                                "pattern": "^[a-z]{2}(-[A-Z]{2})?$"
                            },
                            "isDefault": {
                                "type": "boolean"
                            }
                        },
                        "additionalProperties": false
                    },
                    "Dimensions": {
                        "type": "object",
                        "required": [
                            "height",
                            "width"
                        ],
                        "properties": {
                            "width": {
                                "type": "integer",
                                "minimum": 1
                            },
                            "height": {
                                "type": "integer",
                                "minimum": 1
                            },
                            "aspectRatio": {
                                "type": "array",
                                "items": false,
                                "description": "Tuple of [horizontal, vertical].",
                                "prefixItems": [
                                    {
                                        "type": "integer",
                                        "minimum": 1
                                    },
                                    {
                                        "type": "integer",
                                        "minimum": 1
                                    }
                                ]
                            }
                        },
                        "description": "Width/height pair plus optional aspect ratio (prefixItems tuple).",
                        "additionalProperties": false
                    },
                    "ImageAsset": {
                        "allOf": [
                            {
                                "$ref": "#/definitions/AssetBase"
                            },
                            {
                                "type": "object",
                                "required": [
                                    "colorSpace",
                                    "dimensions",
                                    "kind"
                                ],
                                "properties": {
                                    "kind": {
                                        "const": "image"
                                    },
                                    "hasAlpha": {
                                        "type": "boolean",
                                        "default": false
                                    },
                                    "colorSpace": {
                                        "enum": [
                                            "srgb",
                                            "display-p3",
                                            "adobe-rgb",
                                            "cmyk"
                                        ],
                                        "type": "string"
                                    },
                                    "dimensions": {
                                        "$ref": "#/definitions/Dimensions"
                                    },
                                    "dominantColors": {
                                        "type": "array",
                                        "items": {
                                            "type": "string",
                                            "pattern": "^#(?:[0-9a-fA-F]{3}){1,2}$"
                                        },
                                        "maxItems": 8
                                    }
                                },
                                "dependentRequired": {
                                    "hasAlpha": [
                                        "colorSpace"
                                    ]
                                },
                                "unevaluatedProperties": false
                            }
                        ]
                    },
                    "VideoAsset": {
                        "allOf": [
                            {
                                "$ref": "#/definitions/AssetBase"
                            },
                            {
                                "if": {
                                    "properties": {
                                        "codec": {
                                            "const": "av1"
                                        }
                                    }
                                },
                                "then": {
                                    "required": [
                                        "frameRate"
                                    ]
                                },
                                "type": "object",
                                "required": [
                                    "codec",
                                    "dimensions",
                                    "durationSeconds",
                                    "kind"
                                ],
                                "properties": {
                                    "kind": {
                                        "const": "video"
                                    },
                                    "codec": {
                                        "enum": [
                                            "h264",
                                            "h265",
                                            "av1",
                                            "vp9"
                                        ],
                                        "type": "string"
                                    },
                                    "frameRate": {
                                        "type": "number",
                                        "maximum": 240,
                                        "minimum": 1
                                    },
                                    "dimensions": {
                                        "$ref": "#/definitions/Dimensions"
                                    },
                                    "audioTracks": {
                                        "type": "array",
                                        "items": {
                                            "$ref": "#/definitions/AudioTrack"
                                        },
                                        "contains": {
                                            "$ref": "#/components/schemas/AudioTrack"
                                        },
                                        "minContains": 0
                                    },
                                    "durationSeconds": {
                                        "type": "number",
                                        "exclusiveMinimum": 0
                                    }
                                },
                                "unevaluatedProperties": false
                            }
                        ]
                    },
                    "DocumentAsset": {
                        "allOf": [
                            {
                                "$ref": "#/definitions/AssetBase"
                            },
                            {
                                "type": "object",
                                "required": [
                                    "kind",
                                    "mimeType",
                                    "pageCount"
                                ],
                                "properties": {
                                    "kind": {
                                        "const": "document"
                                    },
                                    "mimeType": {
                                        "type": "string"
                                    },
                                    "pageCount": {
                                        "type": "integer",
                                        "minimum": 1
                                    },
                                    "extractedText": {
                                        "type": [
                                            "string",
                                            "null"
                                        ],
                                        "contentMediaType": "text/plain"
                                    }
                                },
                                "unevaluatedProperties": false
                            }
                        ]
                    }
                },
                "description": "Polymorphic asset; concrete shape selected by `kind`.",
                "discriminator": {
                    "mapping": {
                        "audio": "#/components/schemas/AudioAsset",
                        "image": "#/components/schemas/ImageAsset",
                        "video": "#/components/schemas/VideoAsset",
                        "document": "#/components/schemas/DocumentAsset"
                    },
                    "propertyName": "kind"
                }
            }
        }
    }
}

version: "1.0"

# `schemaUrls` values are stamped into files verbatim, so the shape below is a per-project choice; the built-in
# defaults in `configs/default.config.qip.yaml` use the full `$id` form with the `.schema.yaml` suffix instead.
# The type of a plain service travels in the file name, not in `$schema`. The `contextService` and `mcpService`
# entries are the exception: the backend reads a context or an MCP document by name **and** `$schema`, so those
# two have to match the URIs the backend is configured with, or it imports neither.
configs:
  qip:
    extensions:
      chain: .chain.${appName}.yaml
      contextService: .context-service.${appName}.yaml
      mcpService: .mcp-service.${appName}.yaml
      service: .service.${appName}.yaml
      externalService: .external-service.${appName}.yaml
      internalService: .internal-service.${appName}.yaml
      implementedService: .implemented-service.${appName}.yaml
      specificationGroup: .specification-group.${appName}.yaml
      apiGroup: .api-group.${appName}.yaml
      specification: .specification.${appName}.yaml
      api: .api.${appName}.yaml
    schemaUrls:
      contextService: http://qubership.org/schemas/product/${appName}/context-service
      mcpService: http://qubership.org/schemas/product/${appName}/mcp-service
      service: http://qubership.org/schemas/product/${appName}/service
      externalService: http://qubership.org/schemas/product/${appName}/external-service
      internalService: http://qubership.org/schemas/product/${appName}/internal-service
      implementedService: http://qubership.org/schemas/product/${appName}/implemented-service
      chain: http://qubership.org/schemas/product/${appName}/chain
      specification: http://qubership.org/schemas/product/${appName}/specification
      specificationGroup: http://qubership.org/schemas/product/${appName}/specification-group
      apiGroup: http://qubership.org/schemas/product/${appName}/api-group
      api: http://qubership.org/schemas/product/${appName}/api

  pip:
    extensions:
      chain: .chain.${appName}.yaml
      contextService: .context-service.${appName}.yaml
      mcpService: .mcp-service.${appName}.yaml
      service: .service.${appName}.yaml
      externalService: .external-service.${appName}.yaml
      internalService: .internal-service.${appName}.yaml
      implementedService: .implemented-service.${appName}.yaml
      specificationGroup: .specification-group.${appName}.yaml
      apiGroup: .api-group.${appName}.yaml
      specification: .specification.${appName}.yaml
      api: .api.${appName}.yaml
    schemaUrls:
      contextService: http://qubership.org/schemas/product/${appName}/context-service
      mcpService: http://qubership.org/schemas/product/${appName}/mcp-service
      service: http://qubership.org/schemas/product/${appName}/service
      externalService: http://qubership.org/schemas/product/${appName}/external-service
      internalService: http://qubership.org/schemas/product/${appName}/internal-service
      implementedService: http://qubership.org/schemas/product/${appName}/implemented-service
      chain: http://qubership.org/schemas/product/${appName}/chain
      specification: http://qubership.org/schemas/product/${appName}/specification
      specificationGroup: http://qubership.org/schemas/product/${appName}/specification-group
      apiGroup: http://qubership.org/schemas/product/${appName}/api-group
      api: http://qubership.org/schemas/product/${appName}/api

cache:
  ttl: 60000

